#!/usr/bin/env node
import { createInterface } from "node:readline";
if (process.argv.includes("--version")) { process.stdout.write("codex-cli fake-1.0\n"); process.exit(0); }
const lines = createInterface({ input: process.stdin });
let threadSeq = 0; let turnSeq = 0;
function send(message) { process.stdout.write(`${JSON.stringify(message)}\n`); }
lines.on("line", (line) => {
  const message = JSON.parse(line);
  if (message.method === "initialize") send({ id: message.id, result: { userAgent: "fake" } });
  else if (message.method === "thread/start") send({ id: message.id, result: { thread: { id: `thread-fake-${++threadSeq}` } } });
  else if (message.method === "turn/start") {
    const turnId = `turn-fake-${++turnSeq}`;
    const threadId = message.params?.threadId ?? "thread-fake";
    send({ id: message.id, result: { turn: { id: turnId, status: "inProgress" } } });
    send({ method: "item/started", params: { turnId, item: { type: "agentMessage", id: `item-${turnSeq}` } } });
    send({ method: "item/completed", params: { turnId, item: { type: "agentMessage", id: `item-${turnSeq}`, text: "done" } } });
    send({ method: "turn/completed", params: { threadId, turn: { id: turnId, status: "completed" } } });
  } else if (message.id !== undefined) send({ id: message.id, result: {} });
});
